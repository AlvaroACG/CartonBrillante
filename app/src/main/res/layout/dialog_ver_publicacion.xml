<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A24"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publicación"
                    android:textColor="#F2E6D8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalles y comentarios de la comunidad"
                    android:textColor="#E1B86A"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:contentDescription="Logo CartónGO!"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_carton_go" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_ver_imagen"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_ver_titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="#E1B86A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_ver_detalles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:textColor="#B84A3A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tv_ver_cuerpo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp"
                        android:textColor="#F2E6D8"
                        android:textSize="14sp" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_like"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#3D2C45"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="❤️ Me gusta (0)"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btn_eliminar_publicacion"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🗑️ Eliminar"
                        android:textColor="#E1B86A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_ver_en_mapa"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#1A1A24"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🗺️ Ver en el mapa"
                    android:textColor="#E1B86A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="💬 Comentarios"
                    android:textColor="#E1B86A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_lista_comentarios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/et_nuevo_comentario"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@android:color/transparent"
                            android:hint="Escribe un comentario..."
                            android:maxLength="500"
                            android:paddingHorizontal="14dp"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="13sp" />
                    </androidx.cardview.widget.CardView>

                    <Button
                        android:id="@+id/btn_enviar_comentario"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:backgroundTint="#B84A3A"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Enviar"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_cerrar_dialogo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#1A1A24"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Cerrar"
            android:textColor="#E1B86A"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>