<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#3D2C45"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar con marco redondeado -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardBackgroundColor="#1A1A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivCpItemAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/sym_def_app_icon" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Indicador de estado online en Dorado (#E1B86A) -->
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#E1B86A" />

                    <TextView
                        android:id="@+id/tvCpItemNick"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="SetoKaiba99"
                        android:textColor="#F2E6D8"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCpItemPaisReg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="#B84A3A"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="Chile • TCG"
                        android:textColor="#F2E6D8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCpItemVeces"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#1A1A24"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="x1"
                        android:textColor="#E1B86A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Saludo -->
                <TextView
                    android:id="@+id/tvCpItemSaludo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#1A1A24"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="“¡Buscando cambios de carpeta!”"
                    android:textColor="#E1B86A"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>

        <!-- Datos Opcionales: Deck e Invocación Preferida -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCpItemDeck"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deck: Branded Despia"
                android:textColor="#E1B86A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCpItemInvocacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inv: Fusión"
                android:textColor="#F2E6D8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pie de tarjeta: Ubicación GPS y Fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCpItemUbicacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Guardado en Mapa"
                android:textColor="#E1B86A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCpItemFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visto: Hoy 18:30"
                android:textColor="#F2E6D8"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>