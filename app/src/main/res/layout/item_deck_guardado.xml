<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#3D2C45"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBadgeRegulacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#B84A3A"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="TCG"
                android:textColor="#F2E6D8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#E1B86A" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvItemNombreDeck"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Branded Despia"
            android:textColor="#F2E6D8"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemConteoCartas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="M: 40 | E: 15 | S: 15"
            android:textColor="#E1B86A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemProtectores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Dragon Shield Matte (70)"
            android:textColor="#F2E6D8"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>