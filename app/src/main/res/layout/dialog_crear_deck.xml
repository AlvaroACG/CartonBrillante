<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A24"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. CABECERA CON LOGO Y TÍTULO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Construir Deck"
                    android:textColor="#F2E6D8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configura y sube las fotos de tu mazo"
                    android:textColor="#E1B86A"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:contentDescription="Logo CartónGO!"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_carton_go" />
        </LinearLayout>

        <!-- 2. TARJETA REDONDEADA: DATOS GENERALES DEL DECK -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombre del Deck -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etNombreDeck"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Nombre del Deck (ej. Branded Despia)"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#F2E6D8"
                        android:textColorHint="#E1B86A"
                        android:textSize="14sp" />
                </androidx.cardview.widget.CardView>

                <!-- Interruptor Público / Privado (Opt-in) -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvEstadoVisibilidadDeck"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Visibilidad: Público"
                                android:textColor="#B84A3A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Desactívalo antes de un torneo"
                                android:textColor="#E1B86A"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swDeckPublico"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:buttonTint="#B84A3A"
                            android:checked="true"
                            app:thumbTint="#E1B86A"
                            app:trackTint="#3D2C45" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Regulación del Deck -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Formato:"
                            android:textColor="#E1B86A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgRegulacionDeck"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbDeckTcg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:buttonTint="#B84A3A"
                                android:checked="true"
                                android:text="TCG"
                                android:textColor="#F2E6D8"
                                android:textStyle="bold" />

                            <RadioButton
                                android:id="@+id/rbDeckOcg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="#B84A3A"
                                android:text="OCG"
                                android:textColor="#F2E6D8"
                                android:textStyle="bold" />
                        </RadioGroup>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Protectores (Tipo y Cantidad) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="2"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etTipoProtectores"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="Sleeves (ej. Dragon Shield)"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="13sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etCantidadProtectores"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="Cant. (70)"
                            android:inputType="number"
                            android:paddingHorizontal="14dp"
                            android:singleLine="true"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="13sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. TARJETA REDONDEADA: GESTOR DE FOTOS DEL DECK (MAIN, EXTRA, SIDE) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="Galería del Mazo (Selecciona varias fotos a la vez. Toca para quitar)."
                    android:textColor="#E1B86A"
                    android:textSize="11sp" />

                <!-- ==================== SECCIÓN MAIN DECK ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContadorMain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Main Deck: 0/60"
                        android:textColor="#B84A3A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAgregarFotosMain"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+ Subir"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFotosMain"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="70dp"
                        android:padding="6dp" />
                </androidx.cardview.widget.CardView>

                <!-- ==================== SECCIÓN EXTRA DECK ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContadorExtra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Extra Deck: 0/15"
                        android:textColor="#E1B86A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAgregarFotosExtra"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+ Subir"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFotosExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="70dp"
                        android:padding="6dp" />
                </androidx.cardview.widget.CardView>

                <!-- ==================== SECCIÓN SIDE DECK ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvContadorSide"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Side Deck: 0/15"
                        android:textColor="#F2E6D8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnAgregarFotosSide"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="+ Subir"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFotosSide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="70dp"
                        android:padding="6dp" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>