<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A24"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- 1. LOGO PROTAGONISTA EN PIXEL ART -->
    <ImageView
        android:id="@+id/ivLogoApp"
        android:layout_width="210dp"
        android:layout_height="185dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_carton_go"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TextView original oculto por seguridad si el código Java lo referencia -->
    <TextView
        android:id="@+id/tvMainTitulo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. TARJETA PRINCIPAL REDONDEADA DE INICIO DE SESIÓN -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContenedorLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#3D2C45"
        app:cardCornerRadius="26dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoApp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Bienvenido, Duelista"
                android:textColor="#F2E6D8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="Ingresa tus credenciales para continuar"
                android:textColor="#E1B86A"
                android:textSize="12sp" />

            <!-- Cápsula Redondeada: Usuario / Correo -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="#1A1A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <EditText
                    android:id="@+id/etLoginUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:hint="Correo o Usuario"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="#F2E6D8"
                    android:textColorHint="#E1B86A"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <!-- Cápsula Redondeada: Contraseña -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#1A1A24"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <EditText
                    android:id="@+id/etLoginPass"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@android:color/transparent"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:singleLine="true"
                    android:textColor="#F2E6D8"
                    android:textColorHint="#E1B86A"
                    android:textSize="14sp" />
            </androidx.cardview.widget.CardView>

            <!-- Fila de 2 Botones en Bloques Redondeados -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Botón Principal de Ingreso -->
                <Button
                    android:id="@+id/btnIngresar"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#B84A3A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Ingresar"
                    android:textColor="#F2E6D8"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />

                <!-- Botón de Google Login -->
                <Button
                    android:id="@+id/btnGoogleLogin"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1A1A24"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Google"
                    android:textColor="#E1B86A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. CÁPSULA INFERIOR PARA IR A REGISTRO -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#3D2C45"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardContenedorLogin">

        <Button
            android:id="@+id/btnIrRegistro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="¿No tienes cuenta? Regístrate aquí"
            android:textColor="#E1B86A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>