<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A24">

    <!-- CABECERA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardHeaderMesas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="#3D2C45"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <Button
                android:id="@+id/btnVolverMesas"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:backgroundTint="#1A1A24"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="12dp"
                android:text="← Volver"
                android:textColor="#E1B86A"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloEstadoMesas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control de Mesas"
                    android:textColor="#F2E6D8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- ID REQUERIDO POR JAVA -->
                <TextView
                    android:id="@+id/tvSubtituloRolMesas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando información..."
                    android:textColor="#E1B86A"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="70dp"
                android:layout_height="34dp"
                android:contentDescription="Logo CartónGO!"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_carton_go" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- LISTADO DE MESAS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMesas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="90dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardHeaderMesas" />

    <!-- PANEL INFERIOR PARA TIENDA / JUEZ (ID REQUERIDO POR JAVA) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPanelControlMesas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#3D2C45"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <Button
                android:id="@+id/btnGenerarRonda"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#B84A3A"
                android:text="⚙️ Generar Parejamientos / Siguiente Ronda"
                android:textColor="#F2E6D8"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>