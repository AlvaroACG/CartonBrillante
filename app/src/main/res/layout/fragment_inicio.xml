<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A24"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. FACHADA SUPERIOR: BARRA DE IDENTIDAD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <Button
                    android:id="@+id/btnPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:backgroundTint="#1A1A24"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="Perfil"
                    android:textColor="#E1B86A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="95dp"
                    android:layout_height="38dp"
                    android:contentDescription="Logo CartónGO!"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_carton_go" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. FACHADA CENTRAL: ACCESO PRINCIPAL (HORA DEL DUELO!) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#B84A3A"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <Button
                android:id="@+id/btnCalculadora"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="12dp"
                android:text="Hora del Duelo!"
                android:textColor="#F2E6D8"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="24dp" />
        </androidx.cardview.widget.CardView>

        <!-- 3. FACHADA INFERIOR: CONTENEDOR ENMARCADO PARA ACCESOS RÁPIDOS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Fila 1: CartonPass y Foro -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <Button
                            android:id="@+id/btnCartonPass"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="8dp"
                            android:text="CartonPass"
                            android:textColor="#E1B86A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <Button
                            android:id="@+id/btnForo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="8dp"
                            android:text="Foro"
                            android:textColor="#F2E6D8"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Fila 2: Eventos y Mapa -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <Button
                            android:id="@+id/btnEventos"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="8dp"
                            android:text="Eventos"
                            android:textColor="#F2E6D8"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp">

                        <Button
                            android:id="@+id/btnMapa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="8dp"
                            android:text="Mapa"
                            android:textColor="#F2E6D8"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>