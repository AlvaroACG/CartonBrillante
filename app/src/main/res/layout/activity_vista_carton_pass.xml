<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A24"
    tools:context=".vistaCartonPass">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 1. TARJETA SUPERIOR: CABECERA CON LOGO + OPT-IN + CONFIGURACIÓN GPS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Fila Principal: Volver + Logo CartonPass + Switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnVolverCartonPass"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="10dp"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="← Volver"
                        android:textColor="#E1B86A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <ImageView
                        android:id="@+id/ivLogoCartonPass"
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Logo CartónGO!"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_carton_go" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CartonPass"
                            android:textColor="#F2E6D8"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEstadoCartonPass"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Desactivado"
                            android:textColor="#E1B86A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Switch Principal dentro de píldora oscura -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swActivarCartonPass"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:buttonTint="#B84A3A"
                            android:checked="false"
                            android:paddingHorizontal="8dp"
                            app:thumbTint="#E1B86A"
                            app:trackTint="#B84A3A" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Cápsula Interna: Switch de Ubicación GPS para el Mapa -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:id="@+id/tvEstadoGpsCp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📍 Guardar ubicación del encuentro para el Mapa"
                            android:textColor="#F2E6D8"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/swGuardarUbicacionCp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#E1B86A"
                            android:checked="true"
                            app:thumbTint="#E1B86A"
                            app:trackTint="#3D2C45" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 2. MI TARJETA DE DUELISTA (SOLO VISTA + BOTÓN DE EDITAR) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar en contenedor redondeado -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivMiAvatarCp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="3dp"
                            android:scaleType="centerCrop"
                            android:src="@android:drawable/sym_def_app_icon" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvMiNickCp"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Sin Configurar"
                                android:textColor="#F2E6D8"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <!-- Badge de País/Regulación redondeado -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="#B84A3A"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp">

                                <TextView
                                    android:id="@+id/tvMiPaisRegCp"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="4dp"
                                    android:text="Chile • TCG"
                                    android:textColor="#F2E6D8"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <!-- Burbuja de Saludo Redondeada -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#1A1A24"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:id="@+id/tvMiSaludoCp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:text="“¡Hola! ¡Es hora del Duelo!”"
                                android:textColor="#E1B86A"
                                android:textSize="13sp"
                                android:textStyle="italic" />
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </LinearLayout>

                <!-- Fila de 2 Píldoras (Estilo Widgets): Deck Favorito e Invocación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvMiDeckCp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:text="🎴 Deck: No especificado"
                            android:textColor="#F2E6D8"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvMiInvocacionCp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:text="✨ Inv: Sin preferencia"
                            android:textColor="#E1B86A"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Botón Editar Tarjeta -->
                <Button
                    android:id="@+id/btnEditarMiTarjetaCp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#B84A3A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Editar Mi Tarjeta y Avatar"
                    android:textColor="#F2E6D8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. PANEL DE RADAR / ACCIONES EN TARJETA REDONDEADA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="Radar de Encuentros"
                    android:textColor="#E1B86A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutAccionesRadar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSimularCruce"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#B84A3A"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📡 Escaneo Cercano"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp" />

                    <Button
                        android:id="@+id/btnCruceManual"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🤝 Cruce Directo"
                        android:textColor="#E1B86A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnVerEnMapaCp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#E1B86A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🗺️ Ver Encuentros en el Mapa"
                    android:textColor="#1A1A24"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. LISTA DE DUELISTAS ENCONTRADOS EN CONTENEDOR REDONDEADO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloPlazaCp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Duelistas Encontrados (0)"
                    android:textColor="#F2E6D8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEncuentrosCartonPass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>