<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A24"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. CABECERA DEL FORMULARIO CON EL LOGO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar Carta"
                    android:textColor="#F2E6D8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completa los detalles para tu carpeta"
                    android:textColor="#E1B86A"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="76dp"
                android:layout_height="36dp"
                android:contentDescription="Logo CartónGO!"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_carton_go" />
        </LinearLayout>

        <!-- 2. TARJETA REDONDEADA: PREVIEW DE LA CARTA + BOTONES DE CÁMARA/GALERÍA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Marco de la carta redondeado -->
                <androidx.cardview.widget.CardView
                    android:layout_width="135dp"
                    android:layout_height="188dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivPreviewCarta"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_camera" />
                </androidx.cardview.widget.CardView>

                <!-- Botones para Tomar Foto con Cámara o Elegir de Galería -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTomarFotoCarta"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1A1A24"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="📷 Tomar Foto"
                        android:textColor="#E1B86A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <Button
                        android:id="@+id/btnSeleccionarFoto"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#B84A3A"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="🖼️ Galería"
                        android:textColor="#F2E6D8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 3. TARJETA REDONDEADA: IDENTIFICACIÓN Y REGULACIÓN DE LA CARTA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Datos de la Carta"
                    android:textColor="#E1B86A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Nombre de la Carta -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etNombreCarta"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Nombre (ej. Fallen of Albaz)"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#F2E6D8"
                        android:textColorHint="#E1B86A"
                        android:textSize="14sp" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Regulación de la Carta"
                    android:textColor="#E1B86A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Selector TCG / OCG en Píldora Oscura -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <RadioGroup
                        android:id="@+id/rgRegulacionCarta"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbCartaTcg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="32dp"
                            android:buttonTint="#B84A3A"
                            android:checked="true"
                            android:text="TCG"
                            android:textColor="#F2E6D8"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rbCartaOcg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#B84A3A"
                            android:text="OCG"
                            android:textColor="#F2E6D8"
                            android:textStyle="bold" />
                    </RadioGroup>
                </androidx.cardview.widget.CardView>

                <!-- Fila de 2 Columnas: Código de Set y Rareza -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etCodigoSet"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="Set (ROTD-EN005)"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="12sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etRareza"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="Rareza (Secret...)"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="12sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 4. TARJETA REDONDEADA: ESTADO, CANTIDAD Y PRECIO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="#3D2C45"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Inventario y Valor"
                    android:textColor="#E1B86A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Fila de 2 Columnas: Condición y Cantidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etCondicion"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="Estado (NM, LP)"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="13sp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#1A1A24"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <EditText
                            android:id="@+id/etCantidad"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@android:color/transparent"
                            android:hint="Cantidad (ej. 3)"
                            android:inputType="number"
                            android:paddingHorizontal="12dp"
                            android:singleLine="true"
                            android:textColor="#F2E6D8"
                            android:textColorHint="#E1B86A"
                            android:textSize="13sp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Precio en CLP -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#1A1A24"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <EditText
                        android:id="@+id/etPrecio"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@android:color/transparent"
                        android:hint="Precio en CLP (0 = Solo Cambio)"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#E1B86A"
                        android:textColorHint="#F2E6D8"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>